<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/title_shadow_cyan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_digimon_n_field_guide"
                android:textAppearance="@style/TextAppearance.Cyber.Title"
                android:textColor="#7700e5ff"
                android:gravity="center"
                android:translationX="2dp"
                android:translationY="2dp" />

            <TextView
                android:id="@+id/title_shadow_pink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_digimon_n_field_guide"
                android:textAppearance="@style/TextAppearance.Cyber.Title"
                android:textColor="#77ff0055"
                android:gravity="center"
                android:translationX="-2dp"
                android:translationY="-2dp" />

            <TextView
                android:id="@+id/main_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_digimon_n_field_guide"
                android:textAppearance="@style/TextAppearance.Cyber.Title"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_beginner_guide_spoilers_locked_by_default"
            android:textAppearance="@style/TextAppearance.Cyber.Subtitle"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cyber_panel_bg"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_start_here"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_start_here"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_text_start_here"
                    android:textAppearance="@style/TextAppearance.Cyber.Body"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_app_controls"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_text_controls"
                    android:textAppearance="@style/TextAppearance.Cyber.Body"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_basic_needs"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_needs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_text_needs"
                    android:textAppearance="@style/TextAppearance.Cyber.Body"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_daily_care_loop"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_daily_care"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_text_daily_care"
                    android:textAppearance="@style/TextAppearance.Cyber.Body"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_calls_care_mistakes"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_mistakes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_text_mistakes"
                    android:textAppearance="@style/TextAppearance.Cyber.Body"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_evolution_life_cycle"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_life_cycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_text_life_cycle"
                    android:textAppearance="@style/TextAppearance.Cyber.Body"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/cyber_yellow"
                        android:rotation="45"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_spoilers_monster_index"
                        android:textAppearance="@style/TextAppearance.Cyber.SectionHeader" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_toggle_spoilers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/ui_show_evolution_spoilers"
                    android:textColor="@color/cyber_blue"
                    android:textAppearance="@style/TextAppearance.Cyber.Button"
                    android:background="@drawable/cyber_button_bg" />

                <LinearLayout
                    android:id="@+id/layout_evolution_spoilers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/text_spoiler_intro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_spoilers_ahead_this_block_unlocks_the_full_v1_v2_and_v3"
                        android:textAppearance="@style/TextAppearance.Cyber.Body"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:id="@+id/text_spoiler_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_route_reminder_use_this_as_a_field_guide_not_as_a_promi"
                        android:textAppearance="@style/TextAppearance.Cyber.Body"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="12dp" />

                    <Button
                        android:id="@+id/btn_open_evolution_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/ui_open_interactive_evolution_guide"
                        android:textColor="@color/cyber_blue"
                        android:textAppearance="@style/TextAppearance.Cyber.Button"
                        android:background="@drawable/cyber_button_bg" />

                    <TextView
                        android:id="@+id/text_sources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_sources_and_art_reference_nhoko_xxxxxxxx_jp_digital_mon"
                        android:textAppearance="@style/TextAppearance.Cyber.Muted"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/ui_close_manual"
                    android:textColor="@color/cyber_blue"
                    android:textAppearance="@style/TextAppearance.Cyber.Button"
                    android:background="@drawable/cyber_button_bg"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:background="@color/cyber_yellow"
                android:layout_gravity="top|start"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:background="@color/cyber_yellow"
                android:layout_gravity="top|start"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:background="@color/cyber_yellow"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="10dp" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:background="@color/cyber_yellow"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="10dp" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
